# PocketBase
VITE_POCKETBASE_URL=https://jouw-pb-server.nl

# Weer (OpenWeatherMap)
# Gratis API key: https://openweathermap.org/api
VITE_OWM_API_KEY=jouw_api_key_hier

# GPS-coördinaten van je wijngaard (decimale graden)
VITE_WEER_LAT=51.5
VITE_WEER_LON=5.8

# AI-assistent (Anthropic) — https://console.anthropic.com
# LET OP: deze sleutel komt in de browserbundel terecht en is zichtbaar voor
# gebruikers. Alleen gebruiken voor een privé-app op eigen apparaten.
# Vervalt na Fase 3 (de browser-implementatie is vervangen door de serverhook
# hieronder) — mag leeg blijven.
VITE_ANTHROPIC_API_KEY=sk-ant-...

# AI-agent (Fase 3) — zelfde soort sleutel, maar server-only. Wordt gelezen
# door pocketbase.exe (nooit in de browserbundel). Herstart na wijziging de
# Taakplanner-taak "PocketBase Tappenmars" (zie CLAUDE.md).
ANTHROPIC_API_KEY=sk-ant-...
