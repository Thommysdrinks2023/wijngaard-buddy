# PocketBase
VITE_POCKETBASE_URL=https://jouw-pb-server.nl

# Weer (OpenWeatherMap)
# Gratis API key: https://openweathermap.org/api
VITE_OWM_API_KEY=jouw_api_key_hier

# GPS-coördinaten van je wijngaard (decimale graden)
VITE_WEER_LAT=51.5
VITE_WEER_LON=5.8

# AI-agent (Fase 3) — zelfde soort sleutel, maar server-only. Wordt gelezen
# door pocketbase.exe (nooit in de browserbundel). Herstart na wijziging de
# Taakplanner-taak "PocketBase Tappenmars" (zie CLAUDE.md).
ANTHROPIC_API_KEY=sk-ant-...
